# Database Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/multi_college_cms

# Server Configuration
API_V1_PREFIX=/api
CORS_ORIGINS=["http://localhost:4200","https://ipsa.ac.in","https://www.ipsa.ac.in","https://portal.ipsa.ac.in"]
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)*ipsa\.ac\.in
DEBUG=True

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-or-anon-key
SUPABASE_BUCKET=journals

# Ambition Mic / Brevo Transactional Email
BREVO_API_KEY=your-brevo-api-key
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_FROM_NAME=Ambition Mic Contest
BREVO_FROM_EMAIL=no-reply@portal.ipsa.ac.in
AMBITION_MIC_RECIPIENT=recipient@example.com
AMBITION_MIC_MAX_VIDEO_SIZE=20971520
